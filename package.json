{
  "name": "glucer-desktop",
  "productName": "Glucer",
  "version": "2.1.0",
  "description": "Glucer for desktop",
  "author": "Glucer <hello@glucer.com>",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "dependencies": { "pdf-parse": "1.1.1", "mammoth": "^1.8.0", "xlsx": "0.18.5" },
  "devDependencies": { "electron": "44.9.0", "electron-builder": "^26.0.0" },
  "build": {
    "appId": "com.glucer.desktop",
    "productName": "Glucer",
    "files": ["main.js", "preload.js", "glucer-agent.js", "glucer-extras.js", "quick.html", "quick-preload.js", "offline.html", "package.json", "build/icon.png", "node_modules/**/*"],
    "directories": { "output": "dist" },
    "publish": [{ "provider": "github", "releaseType": "release" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "Glucer-Setup.${ext}" },
    "linux": { "target": ["AppImage"], "category": "Utility", "artifactName": "Glucer-.${ext}" }
  }
}
